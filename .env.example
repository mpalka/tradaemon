# Secrets live here and nowhere else — the code reads them from the environment
# only (src/tradaemon/config.py), never from a checked-in file. Copy this to
# `.env` on a fresh checkout; docker-compose loads it via `env_file`.
# Never commit the real .env.

# Required only for `mode: live`. Create keys with TRADE permission only
# (withdrawals disabled). Paper mode — the default — needs no keys at all,
# and downloading candles uses Binance's public endpoints.
EXCHANGE_API_KEY=
EXCHANGE_API_SECRET=

# Optional. When set, the engine posts alerts (trades, kill-switch, drawdown,
# connection loss) to this URL as {"content": msg, "text": msg} — a shape that
# suits Discord, Slack and Mattermost webhooks alike. Leave empty to disable;
# a webhook outage can never stall the trading loop.
ALERT_WEBHOOK_URL=
